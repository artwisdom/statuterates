---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMeta, prettyDate } from '../lib/data.mjs';
import { recentChanges } from '../lib/changes.mjs';

const meta = getMeta();
const changes = recentChanges(30);
const title = `Recent Rate Changes — ${meta.title}`;
const description = `The most recent statutory, judgment and tax interest-rate changes across the US, UK and EU, newest first. Subscribe via RSS to get every change.`;
const JUR = { US: 'US', GB: 'UK', EU: 'EU' };
---

<BaseLayout title={title} description={description}>
  <h1>Recent rate changes</h1>
  <p class="lead">Every new effective value across the dataset, newest first.</p>
  <aside class="subscribe" aria-label="Subscribe to rate changes">
    <strong>Follow verified rate changes without an account.</strong>
    <span>Subscribe to the <a href="/changes.xml">free RSS feed</a>. Individual rate pages also offer focused feeds when a real change history is available.</span>
  </aside>

  <div class="scroll-x">
    <table>
      <caption>Latest {changes.length} effective values across all series.</caption>
      <thead>
        <tr><th scope="col">Effective</th><th scope="col">Series</th><th scope="col">Rate</th><th scope="col"></th></tr>
      </thead>
      <tbody>
        {changes.map((c) => (
          <tr>
            <td>{prettyDate(c.effective_date)}</td>
            <td><span class="chip">{JUR[c.jurisdiction] || c.jurisdiction}</span> <a href={`/rates/${c.slug}/`}>{c.name}</a></td>
            <td class="num">{c.value_text}</td>
            <td class="source-note">{(c.method || '').includes('provisional') ? 'Provisional' : c.method === 'statute-fixed' ? 'Statute' : c.confidence === 'high' ? 'Published' : 'Derived'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="source-note">Federal post-judgment and 1-year Treasury series produce a new value most
    weeks; Iowa and Texas publish monthly selections; Nebraska changes quarterly; the IRS resets
    quarterly; UK/EU statutory rates semi-annually; policy rates on decision dates. Machine consumers:
    the same data is in the <a href="/api/">JSON API</a>.</p>

  <style>
    .subscribe { display: grid; gap: 3px; margin: 20px 0 28px; padding: 16px 18px; background: var(--green-wash); border: 1px solid var(--line-strong); border-left: 3px solid var(--green); }
    .subscribe span { color: var(--ink-soft); }
  </style>
</BaseLayout>
