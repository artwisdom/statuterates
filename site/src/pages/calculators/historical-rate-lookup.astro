---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import EditorialCredit from '../../components/EditorialCredit.astro';
import HistoricalRateLookup from '../../components/HistoricalRateLookup.astro';
import { getEntity, getMeta } from '../../lib/data.mjs';
import {
  HISTORICAL_RATE_RELEASES,
  historicalRateSeriesForEntity,
} from '../../lib/historical-rate-lookup.mjs';

const meta = getMeta();
const currentAsOf = String(meta.generated_at).slice(0, 10);
const series = HISTORICAL_RATE_RELEASES.map((release) => {
  const reviewed = historicalRateSeriesForEntity(getEntity(release.entitySlug), currentAsOf, {
    sources: meta.sources,
  });
  if (!reviewed) throw new Error(`${release.entitySlug}: reviewed history is unavailable`);
  return {
    slug: reviewed.entitySlug,
    label: reviewed.label,
    inputMeaning: reviewed.inputMeaning,
    branchScope: reviewed.branchScope,
    selectionRule: reviewed.selectionRule,
    coverageNote: reviewed.coverageNote,
    gaps: reviewed.gaps,
    minDate: reviewed.minDate,
    maxDate: reviewed.maxDate,
    historyCount: reviewed.historyCount,
    sourceUrl: reviewed.sourceUrl,
    officialAuthorities: reviewed.officialAuthorities,
    history: reviewed.history.map((point) => ({
      effective_date: point.effective_date,
      value: point.value,
      value_text: point.value_text,
      source_url: point.source_url,
    })),
  };
});

const title = `Historical Judgment Interest Rates by State | Lookup`;
const description = `Look up a recorded judgment interest rate across ${series.length} reviewed state series, with exact dates, branch warnings, official sources, and downloadable history.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Verified Historical Judgment Interest Rate Lookup',
    applicationCategory: 'ReferenceApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    url: canonical,
    description,
    dateModified: currentAsOf,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Calculators', item: new URL('/calculators/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Historical rate lookup', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} monetize={true}>
  <nav aria-label="Breadcrumb" style="font-size:.9rem;color:var(--ink-soft);margin-bottom:6px">
    <a href="/calculators/">Calculators</a> &rsaquo; <span>Historical rate lookup</span>
  </nav>
  <h1>Verified historical judgment interest rate lookup</h1>
  <p class="lead">Choose one of {series.length} reviewed state series and a date to retrieve the recorded annual
    value, effective period, branch warning, official source, and downloadable history. The tool
    refuses unsupported dates and documented gaps rather than substituting today’s rate.</p>
  <EditorialCredit kind="calculator-lookup" reviewedOn="2026-08-22" />

  <HistoricalRateLookup {series} {currentAsOf} />

  <AdSlot id="historical-lookup-top" />

  <h2>Why a historical lookup matters</h2>
  <p>A current percentage is often the wrong answer for an older judgment. Some states select a rate
    by entry month or year; others publish quarterly, semiannual, or annual schedules that can reset
    while a balance remains unpaid. This tool searches the stored official history using the date
    meaning shown for each series. It never applies a later value retroactively.</p>

  <h2>What this tool does—and does not decide</h2>
  <ul class="clean">
    <li><strong>It identifies a recorded period rate.</strong> The result includes the period start,
      official source, full rate page, and CSV history.</li>
    <li><strong>It does not calculate a payoff.</strong> Accrual date, principal, interest-bearing
      costs, compounding, partial payments, and end-date treatment remain separate questions.</li>
    <li><strong>It does not choose a legal branch.</strong> A contract, claim type, judgment size,
      debtor category, or another statute can supply a different rate.</li>
    <li><strong>It fails closed.</strong> Dates before the verified history, after source-aware
      coverage, or inside a documented publication gap are rejected instead of estimated.</li>
  </ul>

  <h2>Why only these {series.length} series are released</h2>
  <p>A long table alone is not enough. Every released series has reviewed official history, a precise
    interpretation for the date input, a source-aware end boundary, and branch language that prevents
    a historical observation from posing as a complete payoff calculation. Other states remain
    available as current references and will enter this lookup only when those same checks pass.</p>

  <h2>Supported series and official sources</h2>
  <ul class="clean">
    {series.map((item) => (
      <li>
        <a href={`/rates/${item.slug}/`}><strong>{item.label}</strong></a> — {item.historyCount}
        {' '}recorded periods from {item.minDate} through {item.maxDate}. {item.inputMeaning}:
        {' '}{item.branchScope}
        {' '}<a href={item.sourceUrl} rel="noopener" target="_blank">Official source</a>.
        {item.officialAuthorities[0] && (
          <> {' '}<a href={item.officialAuthorities[0].url} rel="noopener" target="_blank">
            Governing authority</a>.</>
        )}
        {' '}<a href={`/api/v1/entity/${item.slug}.csv`}>Download CSV</a>.
      </li>
    ))}
  </ul>

  <AdSlot id="historical-lookup-bottom" />

  <div class="disclaimer">Reference information only—not legal advice. Confirm the judgment date,
    applicable branch, official source, and calculation method before relying on a historical rate.</div>
</BaseLayout>
