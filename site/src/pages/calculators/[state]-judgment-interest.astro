---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import InterestCalculator from '../../components/InterestCalculator.astro';
import CiteThis from '../../components/CiteThis.astro';
import { getMeta, stateHubs, historyFor, latestOf, prettyDate, isCalculatorReady, STATE_CALCULATOR_RENDERER_READY } from '../../lib/data.mjs';
import { copyFor } from '../../lib/content.mjs';
import { fixedSimpleInterest, fixedCompoundInterest } from '../../../../shared/interest-calc.mjs';

// One page per state that has a post-judgment rate (all 50 + D.C.). The heavy state-specific substance
// — verified rate, statute, accrual rule, compounding, carve-outs, worked example — is what keeps these
// from being thin programmatic shells.
export function getStaticPaths() {
  // These pages must not ship until the state rule model can prove rate history, reset/lock rules,
  // compounding, claim-type branches, and source quality. Preserve the work without indexing it.
  if (!STATE_CALCULATOR_RENDERER_READY || import.meta.env.ENABLE_STATE_CALCULATORS !== 'true') return [];
  return stateHubs().filter((h) => h.post && isCalculatorReady(h.post)).map((h) => ({ params: { state: h.base }, props: { hub: h } }));
}

const { hub } = Astro.props;
const { base, name, post, pre } = hub;
const meta = getMeta();
const latest = latestOf(post);
const copy = copyFor(post.slug);
const statute = post.metadata?.statute || '';
const theName = base === 'dc' ? 'the District of Columbia' : name;

// Prototype assumptions retained for Phase 2 review. These must be replaced by each entity's
// structured calculation metadata before STATE_CALCULATOR_RENDERER_READY can be enabled.
const COMPOUND = new Set(['colorado', 'kentucky', 'michigan', 'south-carolina', 'texas']);
const isCompound = COMPOUND.has(base);
const isFixed = latest?.method === 'statute-fixed';

// Prototype dual-rate branches retained for Phase 2 review; they are not published.
const DUAL = {
  minnesota: [{ v: 4, label: 'Judgment $50,000 or less — 4%' }, { v: 10, label: 'Judgment over $50,000 — 10%' }],
  missouri: [{ v: 9, label: 'Contract / non-tort — 9%' }, { v: 8.75, label: 'Tort judgment — 8.75%' }],
  'new-jersey': [{ v: 4.5, label: 'Judgment up to $20,000 — 4.5%' }, { v: 6.5, label: 'Judgment over $20,000 — 6.5%' }],
  'new-mexico': [{ v: 8.75, label: 'General judgment — 8.75%' }, { v: 15, label: 'Tort / bad-faith judgment — 15%' }],
  washington: [{ v: 12, label: 'General money judgment — 12%' }, { v: 8.75, label: 'Tort judgment — 8.75%' }],
};
const dual = DUAL[base] || null;

// Prototype-only synthetic anchors. They are one reason this renderer is hard-disabled: Phase 2 must
// use documented effective dates and recorded observations instead of extending values backward.
const anchorFor = (v) => [{ effective_date: '1990-01-01', value: v }];
const realHist = historyFor(post.slug).sort((a, b) => (a.effective_date < b.effective_date ? -1 : 1));
const oldestVal = realHist[0]?.value ?? latest?.value;
const singleHistory = [{ effective_date: '1990-01-01', value: oldestVal }, ...realHist];

const calcKind = isCompound ? 'fixed-compound' : 'fixed-simple';
let histories, defaultSeries, seriesOptions;
if (dual) {
  histories = { a: anchorFor(dual[0].v), b: anchorFor(dual[1].v) };
  defaultSeries = 'a';
  seriesOptions = [{ key: 'a', label: dual[0].label }, { key: 'b', label: dual[1].label }];
} else {
  histories = { [base]: singleHistory };
  defaultSeries = base;
  seriesOptions = null;
}

// Worked example at build time (same engine the calculator uses → the numbers match). Fixed dates, so
// the figure only moves when the rate itself moves — never on a rebuild.
const EX_PRINCIPAL = 10000;
const EX_START = '2024-01-01';
const EX_END = '2026-01-01';
const exFn = isCompound ? fixedCompoundInterest : fixedSimpleInterest;
// Dual-rate states: the example uses the primary rate; label it with that specific rate (not the "A/B" text).
const exampleRateLabel = dual ? `${dual[0].v}%` : latest?.value_text;
let example = null;
try {
  example = exFn({ principal: EX_PRINCIPAL, startDate: EX_START, endDate: EX_END, history: anchorFor(dual ? dual[0].v : latest?.value) });
} catch (e) { example = null; }
const fmtUsd = (n) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const rateForTitle = dual ? `${dual[0].v}%` : latest?.value_text;
const title = `${name} Judgment Interest Calculator — ${rateForTitle}${statute ? ` (${statute})` : ''} | ${meta.title}`;
const description = `Prototype ${name} post-judgment interest calculator retained for verification and not published.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const methodLabel = isCompound ? 'compounded annually' : 'simple interest (daily, rate ÷ 365)';

const faqs = [
  {
    q: `What is the post-judgment interest rate in ${name}?`,
    a: `As of ${prettyDate(latest?.effective_date)}, the ${name} post-judgment interest rate is ${latest?.value_text} per year under ${statute}, applied as ${methodLabel}. ${copy.tagline || ''}`,
  },
  {
    q: `How is ${name} judgment interest calculated?`,
    a: `Interest accrues on the unpaid judgment from entry until it is paid. This calculator applies ${name}'s ${latest?.value_text} statutory rate as ${methodLabel}, and also shows the daily (per-diem) amount you can use to state a payoff as of any date.`,
  },
  isFixed
    ? {
        q: `Does the ${name} judgment interest rate change over time?`,
        a: `${name}'s rate is fixed by statute, so it changes only when the legislature amends it — a judgment keeps its rate. Always confirm against the current statute before you rely on a figure.`,
      }
    : {
        q: `Is the ${name} rate fixed at entry or does it float?`,
        a: `${name}'s rate is set by a formula that resets periodically, and for most judgments the rate is fixed at entry for the life of the judgment. This tool applies the current ${latest?.value_text} rate; for a judgment entered in an earlier period, use the rate that was in effect then — see the full effective-date history on the rate page.`,
      },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['WebApplication', 'SoftwareApplication'],
    name: `${name} Judgment Interest Calculator`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: canonical,
    description: `Computes ${name} post-judgment interest at the ${latest?.value_text} statutory rate under ${statute}.`,
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Calculators', item: new URL('/calculators/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `${name} judgment interest`, item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" style="font-size:.9rem;color:var(--ink-soft);margin-bottom:6px">
    <a href="/calculators/">Calculators</a> &rsaquo; <span>{name} judgment interest</span>
  </nav>
  <h1>{name} judgment interest calculator</h1>
  <p class="lead">Calculate post-judgment interest on a {theName} money judgment at the statutory rate of
    <strong>{latest?.value_text}</strong> — {methodLabel}, recorded with <a href="/editorial-policy/">a cited
    rule and source</a>. Enter the judgment amount and dates for the total interest and the daily per-diem.</p>

  <div class="rate-hero">
    <div class="eyebrow">Current {name} rate</div>
    <span class="value">{latest?.value_text}</span>
    <span class="asof">per year, {methodLabel} · effective {prettyDate(latest?.effective_date)} ·
      <a href={`/rates/${post.slug}/`}>{statute}</a></span>
  </div>

  <InterestCalculator
    kind={calcKind}
    histories={histories}
    defaultSeries={defaultSeries}
    seriesOptions={seriesOptions}
    principalLabel="Judgment amount"
    startLabel="Date interest begins (entry of judgment)"
    endLabel="Calculated through (e.g. payment date)"
  />
  <p class="source-note">{dual
    ? `${name} sets more than one statutory rate — pick the one that fits your judgment above. `
    : ''}{isFixed
      ? `${name}'s current record is statute-fixed; this prototype must not be used for dates before its documented effective date.`
      : `This prototype contains only the observations currently recorded; it must not be used where an earlier rate is missing.`} Estimate only — confirm against the statute and your court's rules.</p>

  <AdSlot id="calc-top" />

  {example && (
    <section class="example">
      <h2>Worked example</h2>
      <p>A <strong>{fmtUsd(EX_PRINCIPAL)}</strong> {name} judgment entered <strong>{prettyDate(EX_START)}</strong>
        and paid <strong>{prettyDate(EX_END)}</strong> ({example.days} days) accrues about
        <strong>{fmtUsd(example.interest)}</strong> in interest at the {exampleRateLabel} rate
        ({methodLabel}), for a total of <strong>{fmtUsd(example.total)}</strong>
        {example.daily_amount !== undefined && <> — roughly <strong>{fmtUsd(example.daily_amount)}/day</strong></>}.
        Run your own numbers above.</p>
    </section>
  )}

  <h2>How {name} judgment interest works</h2>
  <p>{copy.body}</p>
  <p class="xlink"><a href={`/rates/${post.slug}/`}>→ Full {name} post-judgment rate page</a> — cited rule,
    recorded observations, carve-outs, and source details.</p>

  <ul class="clean">
    <li><strong>Rate:</strong> {latest?.value_text} per year under {statute}.</li>
    <li><strong>Compounding:</strong> {isCompound ? 'compounded annually — interest is added to the balance each year and the next year accrues on the larger total.' : 'simple interest — accrues on the original judgment amount, not on accrued interest.'}</li>
    <li><strong>Accrual:</strong> daily, from entry of judgment until the judgment is satisfied.</li>
    <li><strong>Prejudgment interest</strong> (for the period <em>before</em> judgment) is separate —
      see <a href={`/rates/${pre.slug}/`}>{name} prejudgment interest</a>.</li>
  </ul>

  <AdSlot id="calc-mid" />

  <h2>Frequently asked</h2>
  <div class="faq">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <p class="source-note" style="margin-top:20px">See <a href={`/states/${base}/`}>all {name} interest
    rates</a>, <a href="/calculators/">every interest calculator</a>, or the
    <a href="/calculators/state-judgment-interest/">multi-state comparison calculator</a>. Federal-court
    judgments use a different statute — the <a href="/calculators/post-judgment-interest/">federal §1961
    calculator</a>.</p>

  <CiteThis title={`${name} Judgment Interest Calculator`} url={canonical} note={`${name} post-judgment rate ${latest?.value_text}, recorded with the cited ${statute} rule and effective ${prettyDate(latest?.effective_date)}.`} />

  <AdSlot id="calc-bottom" />

  <div class="disclaimer">
    Reference estimate only — not legal, tax, or financial advice. Judgment interest rules (rate,
    compounding, accrual date, and carve-outs) turn on the controlling statute and your court's practice;
    confirm against the official source before relying on any figure.
  </div>

  <style>
    .example { background: var(--paper-2); border: 1px solid var(--line); border-radius: 12px; padding: 4px 20px 8px; margin: 18px 0; }
    .xlink { margin: 12px 0; }
    .xlink a { color: var(--green); text-decoration: none; border-bottom: 1px solid var(--line-strong); }
    .xlink a:hover { border-bottom-color: var(--green); }
    .faq details { border-top: 1px solid var(--line); padding: 12px 0; }
    .faq summary { cursor: pointer; font-weight: 600; font-family: var(--serif); font-size: 1.05rem; }
    .faq p { margin: 8px 0 0; color: var(--ink-soft); }
  </style>
</BaseLayout>
