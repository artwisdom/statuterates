---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CiteThis from '../../components/CiteThis.astro';
import { getAllEntities, getEntity, getMeta, latestOf, prettyDate, prettyDateTime, isPrejudgment, isCalculatorReady, PREJUDGMENT_CALC_SAFE, STATE_CALCULATOR_RENDERER_READY } from '../../lib/data.mjs';
import { contentModifiedFor, copyFor } from '../../lib/content.mjs';

export function getStaticPaths() {
  return getAllEntities().map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const entity = getEntity(slug);
const meta = getMeta();
const copy = copyFor(slug);
const JUR = { US: 'United States', GB: 'United Kingdom', EU: 'European Union' };
const latest = latestOf(entity);
const history = (entity.history?.annual_rate || []).slice(0, 40); // recent history for the table
const totalPoints = (entity.history?.annual_rate || []).length;

const isDerived = latest?.confidence !== 'high';
const isStatuteFixed = (latest?.method || '').startsWith('statute-fixed');
const isStatutory = (latest?.method || '').startsWith('statute'); // fixed OR agency-set variable
const isProvisional = (latest?.method || '').includes('provisional');
const isCaseSpecific = latest?.method === 'court-or-contract-rate';
const isFormulaDerived = (latest?.method || '').startsWith('derived_');
const unitLabel = 'per year';

// Which calculator (if any) uses this series — internal linking both helps users and SEO.
const CALC_FOR = {
  'irs-underpayment': '/calculators/irs-penalty-and-interest/',
  'irs-overpayment-noncorporate': '/calculators/irs-interest/',
  'irs-overpayment-corporate': '/calculators/irs-interest/',
  'irs-large-corporate-underpayment': '/calculators/irs-interest/',
  'us-federal-post-judgment': '/calculators/post-judgment-interest/',
  'treasury-1-year-cmt': '/calculators/post-judgment-interest/',
  'uk-late-payment-commercial': '/calculators/late-payment-interest/',
  'boe-bank-rate': '/calculators/late-payment-interest/',
  'eu-late-payment-reference': '/calculators/late-payment-interest/',
  'ecb-main-refinancing-rate': '/calculators/late-payment-interest/',
  'california-judgment-rate': '/calculators/state-judgment-interest/',
  'new-york-judgment-rate': '/calculators/state-judgment-interest/',
  'new-york-consumer-debt-judgment-rate': '/calculators/state-judgment-interest/',
  'massachusetts-judgment-rate': '/calculators/state-judgment-interest/',
  'pennsylvania-judgment-rate': '/calculators/state-judgment-interest/',
  'illinois-judgment-rate': '/calculators/state-judgment-interest/',
  'north-carolina-judgment-rate': '/calculators/state-judgment-interest/',
  'virginia-judgment-rate': '/calculators/state-judgment-interest/',
  'alabama-judgment-rate': '/calculators/state-judgment-interest/',
  'hawaii-judgment-rate': '/calculators/state-judgment-interest/',
  'indiana-judgment-rate': '/calculators/state-judgment-interest/',
  'maryland-judgment-rate': '/calculators/state-judgment-interest/',
  'new-mexico-judgment-rate': '/calculators/state-judgment-interest/',
  'oregon-judgment-rate': '/calculators/state-judgment-interest/',
  'rhode-island-judgment-rate': '/calculators/state-judgment-interest/',
  'south-dakota-judgment-rate': '/calculators/state-judgment-interest/',
  'vermont-judgment-rate': '/calculators/state-judgment-interest/',
  'wyoming-judgment-rate': '/calculators/state-judgment-interest/',
  'iowa-judgment-rate': '/calculators/state-judgment-interest/',
};
// Prejudgment slugs get the calculator link only for the fixed-simple "safe" states (single source
// of truth in data.mjs); everything else uses the explicit CALC_FOR map.
const candidateCalcHref = CALC_FOR[slug]
  || (slug.endsWith('-prejudgment-rate') && PREJUDGMENT_CALC_SAFE.includes(slug.replace('-prejudgment-rate', ''))
        ? '/calculators/prejudgment-interest/'
        : null);
const isStateCalculator = candidateCalcHref === '/calculators/state-judgment-interest/'
  || candidateCalcHref === '/calculators/prejudgment-interest/';
const manualStateCalcHref = !isPrejudgment(entity) && slug.endsWith('-judgment-rate')
  ? '/calculators/judgment-interest/'
  : null;
const calcHref = isStateCalculator
  ? (STATE_CALCULATOR_RENDERER_READY && import.meta.env.ENABLE_STATE_CALCULATORS === 'true' && isCalculatorReady(entity)
      ? candidateCalcHref
      : manualStateCalcHref)
  : (candidateCalcHref || manualStateCalcHref);

// Prejudgment interest is a distinct metric with claim-type restrictions front and center, plus
// two-way cross-links to the state's post-judgment page.
const pj = isPrejudgment(entity);
const stateName = entity.name.replace(/ (?:Pre|Post-)?[Jj]udgment Interest Rate$/, '');
const isStateRate = String(entity.region || '').startsWith('US States')
  && (slug.endsWith('-judgment-rate') || slug.endsWith('-prejudgment-rate'));
const rateYear = String(latest?.retrieved_at || latest?.effective_date || '').slice(0, 4);
const statuteLabel = (entity.metadata?.statute || '')
  .replace(/\bSec\.\s*/g, '§ ')
  .replace(/\s+/g, ' ')
  .trim();
const seoStatuteLabel = {
  'iowa-judgment-rate': 'Iowa Code §668.13',
  'maryland-judgment-rate': 'Md. Code Cts. & Jud. Proc. §11-107',
  'nebraska-judgment-rate': 'Neb. Rev. Stat. §45-103',
  'new-jersey-judgment-rate': 'N.J. Ct. R. 4:42-11',
  'pennsylvania-judgment-rate': '42 Pa.C.S. §8101',
  'texas-judgment-rate': 'Tex. Fin. Code §304.003',
}[slug] || statuteLabel;
const provisionalConfirmation = slug.startsWith('maine-')
  ? 'Maine Judicial Branch annual chart'
  : 'Iowa Judicial Branch table';
const allSlugs = new Set(getAllEntities().map((e) => e.slug));
let postSibling = null, preSibling = null;
if (pj) {
  const ps = copy.postSlug || slug.replace('-prejudgment-rate', '-judgment-rate');
  if (allSlugs.has(ps)) postSibling = ps;
} else if (slug.endsWith('-judgment-rate')) {
  const prs = slug.replace('-judgment-rate', '-prejudgment-rate');
  if (allSlugs.has(prs)) preSibling = prs;
}

// Link up to the state hub (topical cluster) when this rate belongs to a state that has one.
const hubBases = new Set([...allSlugs].filter((s) => s.endsWith('-prejudgment-rate')).map((s) => s.replace('-prejudgment-rate', '')));
const rateBase = slug.replace(/-(?:pre)?judgment-rate$/, '');
const hubHref = hubBases.has(rateBase) ? `/states/${rateBase}/` : null;

const statuteTitle = {
  'kentucky-judgment-rate': `KRS 360.040: Kentucky Judgment Interest Rate ${rateYear}`,
  'washington-judgment-rate': `RCW 4.56.110: Washington Judgment Interest Rates ${rateYear}`,
}[slug];
const stateRateKind = pj ? (isCaseSpecific ? 'Prejudgment Interest Rules' : 'Prejudgment Interest Rate') : 'Post-Judgment Interest Rate';
const stateTitleWithValue = `${stateName} ${stateRateKind} ${rateYear}${isCaseSpecific ? '' : `: ${latest?.value_text}`}`;
const stateTitleWithoutValue = `${stateName} ${stateRateKind} ${rateYear}`;
const targetedTitle = statuteTitle
  || (isStateRate ? stateTitleWithValue : null)
  || (slug === 'irs-underpayment' ? `IRS Underpayment Interest Rate ${rateYear}: ${latest?.value_text}` : null)
  || `${entity.name} | ${meta.title}`;
const title = targetedTitle.length <= 65
  ? targetedTitle
  : isStateRate && stateTitleWithoutValue.length <= 65
    ? stateTitleWithoutValue
    : entity.name;
const statePreDescriptionDetailed = `${rateYear} ${stateName} prejudgment interest ${isCaseSpecific ? 'rule' : `rate: ${latest?.value_text}`}. See when it applies, accrual, compounding, ${seoStatuteLabel}, exceptions, and the official source.`;
const statePreDescriptionCompact = `${rateYear} ${stateName} prejudgment interest ${isCaseSpecific ? 'rule' : `rate: ${latest?.value_text}`}. See applicability, accrual, compounding, exceptions, and the cited official source.`;
const description = isStateRate
  ? pj
    ? (statePreDescriptionDetailed.length <= 160 ? statePreDescriptionDetailed : statePreDescriptionCompact)
    : `${rateYear} ${stateName} post-judgment interest rate: ${latest?.value_text} per year. See ${seoStatuteLabel}, effective date, exceptions, history, and official source.`
  : slug === 'uk-late-payment-commercial'
  ? `${rateYear} UK statutory interest on late commercial payments: ${latest?.value_text} per year. See the current rate, effective dates, calculation rules, and cited source.`
  : isProvisional
  ? `${stateName} judgment interest estimate: ${latest?.value_text} ${unitLabel} from official H.15 inputs, pending confirmation in the ${provisionalConfirmation}. Statute, caveats, and official history.`
  : isCaseSpecific
    ? `${stateName} prejudgment interest has no uniform statewide percentage: use the governing contract rate or the rate selected by the court. See the rule, scope, and cited source.`
  : pj
    ? `Current ${stateName} prejudgment interest rate: ${latest?.value_text} ${unitLabel}. See when it applies, accrual rules, the cited statute, and recorded observations.`
    : `${copy.q} As of ${prettyDate(latest?.effective_date)}: ${latest?.value_text} ${unitLabel}. Cited source and recorded effective-date history.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Stale-proof the descriptive prose: for single-value variable state series, swap any hardcoded
// "currently X%" phrase for the live figure from the dataset, so the
// paragraph can never drift from the hero. Dual-rate "A% / B%" series keep their curated copy, which
// names each component explicitly.
const bodyText = (latest?.value_text && !latest.value_text.includes('/'))
  ? copy.body.replace(/currently \d+(?:\.\d+)?%/i, `currently ${latest.value_text}`)
  : copy.body;
const pageModified = [
  String(latest?.retrieved_at || latest?.effective_date || '').slice(0, 10),
  contentModifiedFor(slug),
].filter(Boolean).sort().at(-1);

// Provenance line for the "Cite this page" block.
const citeStatute = entity.metadata?.statute;
const citeNote = isProvisional
  ? `Provisional H.15-based calculation dated ${prettyDate(latest?.effective_date)}; pending ${provisionalConfirmation} confirmation.`
  : isCaseSpecific
  ? `Case-specific rule recorded under ${citeStatute}; no uniform numeric percentage is published.`
  : citeStatute
  ? `Rate recorded under ${citeStatute}${latest?.effective_date ? `, effective ${prettyDate(latest.effective_date)}` : ''}.`
  : (latest?.effective_date ? `Value effective ${prettyDate(latest.effective_date)}.` : '');
const sourceRecord = (meta.sources || []).find((source) => source.id === latest?.source_id);
const basisLabel = isCaseSpecific
  ? 'Case-specific rule'
  : isProvisional
    ? 'Provisional estimate'
    : latest?.method === 'statute-branching'
      ? 'Statutory branches'
      : isStatuteFixed
        ? 'Fixed by statute'
        : isStatutory
          ? 'Statutory formula / table'
          : isFormulaDerived
            ? 'Formula value'
            : latest?.confidence === 'high'
              ? 'Published value'
              : 'Derived value';
const pageHeading = isStateRate
  ? `${stateName} ${pj ? 'prejudgment' : 'post-judgment'} interest ${isCaseSpecific ? 'rules' : 'rate'}`
  : entity.name;
const factsHeading = isStateRate
  ? `${rateYear} ${stateName} ${pj ? 'prejudgment' : 'post-judgment'} interest at a glance`
  : `${entity.name} at a glance`;

// JSON-LD: a Dataset for this series, a FAQPage for the current-value question, and breadcrumbs.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: entity.name,
    description: bodyText.replace(/\s+/g, ' ').trim(),
    url: canonical,
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: meta.title },
    dateModified: pageModified,
    variableMeasured: {
      '@type': 'PropertyValue',
      name: entity.name,
      unitText: isCaseSpecific ? 'case-specific legal rule' : 'percent per annum',
      value: isCaseSpecific ? latest?.value_text : latest?.value,
    },
    distribution: {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: new URL(`/api/v1/entity/${slug}.json`, Astro.site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: copy.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: isCaseSpecific
            ? `${entity.name} has no uniform statewide percentage: the governing contract or the judge supplies the rate. ${copy.tagline}`
            : `${isProvisional ? 'Provisional estimate' : `As of ${prettyDate(latest?.effective_date)}`}: ${entity.name} is ${latest?.value_text} ${unitLabel}. ${copy.tagline}`,
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Rates', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: entity.name, item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" style="font-size:.9rem;color:var(--ink-soft);margin-bottom:6px">
    <a href="/">Rates</a> &rsaquo; <span>{entity.name}</span>
  </nav>
  <h1>{pageHeading}</h1>
  <p class="lead"><span class="chip">{JUR[entity.jurisdiction] || entity.jurisdiction}</span> &nbsp;{copy.tagline}</p>
  {hubHref && (
    <p class="hublink"><a href={hubHref}>→ All {stateName} judgment &amp; prejudgment interest rates</a></p>
  )}

  <div class="rate-hero">
    <div class="eyebrow">{isCaseSpecific ? 'Current rule' : isProvisional ? 'Provisional current estimate' : 'Current rate'}</div>
    <span class="value">{latest?.value_text}</span>
    <span class="asof">
      {isCaseSpecific
        ? <>— no uniform statewide percentage</>
        : isProvisional
        ? <>per year — official H.15 input, pending {provisionalConfirmation} confirmation</>
        : pj
        ? (copy.kind?.startsWith('discretionary-')
            ? <>per year — a statutory reference or ceiling when prejudgment interest is awarded</>
            : copy.kind === 'variable'
              ? <>per year — current formula value, effective {prettyDate(latest?.effective_date)}</>
              : copy.kind === 'same-as-postjudgment'
                ? <>per year — the same rate as post-judgment interest, effective {prettyDate(latest?.effective_date)}</>
                : <>per year — statutory prejudgment reference (source checked {prettyDate(latest?.retrieved_at)})</>)
        : isStatuteFixed
          ? <>per year — current statutory reference (source checked {prettyDate(latest?.retrieved_at)})</>
          : <>{unitLabel}, effective {prettyDate(latest?.effective_date)}</>}
      <br />
      <span class={`badge ${latest?.confidence === 'high' ? 'high' : 'medium'}`}>
        {basisLabel}
      </span>
      {pj && copy.kindLabel && <span class="kind-chip">{copy.kindLabel}</span>}
    </span>
  </div>

  <section class="rate-facts" aria-labelledby="rate-facts-heading">
    <h2 id="rate-facts-heading">{factsHeading}</h2>
    <dl>
      <div>
        <dt>{isCaseSpecific ? 'Current rule' : 'Current rate'}</dt>
        <dd>{latest?.value_text}{isCaseSpecific ? '' : ' per year'}</dd>
      </div>
      <div>
        <dt>Effective date</dt>
        <dd>{prettyDate(latest?.effective_date)}</dd>
      </div>
      <div>
        <dt>Controlling authority</dt>
        <dd>{statuteLabel || 'See cited source'}</dd>
      </div>
      <div>
        <dt>Rate basis</dt>
        <dd>{basisLabel}</dd>
      </div>
      <div>
        <dt>Source checked</dt>
        <dd>{prettyDate(latest?.retrieved_at)}</dd>
      </div>
      <div>
        <dt>Recorded history</dt>
        <dd>{totalPoints} data point{totalPoints === 1 ? '' : 's'}</dd>
      </div>
    </dl>
  </section>

  <p>{bodyText}</p>

  {!pj && copy.postDetails && (
    <section class="applies">
      <h2>How {stateName} post-judgment interest works</h2>
      <div class="applies-grid">
        <div>
          <h3>Which rate applies</h3>
          <p>{copy.postDetails.scope}</p>
        </div>
        <div>
          <h3>When interest accrues</h3>
          <p>{copy.postDetails.accrual}</p>
        </div>
        <div>
          <h3>Compounding and rate lock</h3>
          <p>{copy.postDetails.compounding}</p>
        </div>
        <div>
          <h3>Official history coverage</h3>
          <p>{copy.postDetails.history}</p>
        </div>
      </div>
    </section>
  )}

  {calcHref && (
    <p><a href={calcHref}><strong>
      {slug === 'irs-underpayment'
        ? '→ Estimate Form 1040 penalties and interest'
        : '→ Calculate interest at this rate'}
    </strong></a></p>
  )}
  {slug === 'irs-underpayment' && (
    <p><a href="/calculators/irs-interest/">Need interest-only or refund math? Open the IRS interest calculator.</a></p>
  )}

  {preSibling && (
    <p class="xlink"><a href={`/rates/${preSibling}/`}>→ See {stateName}’s <strong>prejudgment</strong> interest rate (interest <em>before</em> judgment — different rules)</a></p>
  )}

  {pj ? (
    <section class="applies">
      <h2>When {stateName} prejudgment interest applies</h2>
      <p class="applies-lead">{copy.applies}</p>
      <div class="applies-grid">
        <div>
          <h3>When it starts accruing</h3>
          <p>{copy.accrual}</p>
        </div>
        <div>
          <h3>Simple or compound</h3>
          <p>{copy.compound}</p>
        </div>
        {copy.formula && (
          <div>
            <h3>How the rate is set</h3>
            <p>{copy.formula}</p>
          </div>
        )}
      </div>
      {postSibling && (
        <p class="xlink"><a href={`/rates/${postSibling}/`}>→ Compare with the {stateName} <strong>post-judgment</strong> interest rate (interest <em>after</em> judgment)</a></p>
      )}
      <p class="fineprint">{latest?.notes}</p>
    </section>
  ) : (isDerived || isStatutory) && (
    <div class="disclaimer">
      <strong>{isStatutory ? 'Statutory basis & carve-outs.' : 'How this value is derived.'}</strong> {latest?.notes}
    </div>
  )}

  <AdSlot id="rate-top" />

  <h2>Effective-date history</h2>
  <div class="scroll-x">
    <table>
      <caption>
        {totalPoints} data point{totalPoints === 1 ? '' : 's'} on record{totalPoints > history.length ? ` (showing the most recent ${history.length})` : ''}.
        All recorded observations are in the <a href={`/api/v1/entity/${slug}.json`}>JSON API</a>.
      </caption>
      <thead>
        <tr><th scope="col">Effective date</th><th scope="col">Rate</th><th scope="col">Basis</th></tr>
      </thead>
      <tbody>
        {history.map((o) => (
          <tr>
            <td>{prettyDate(o.effective_date)}</td>
            <td class="num">{o.value_text}</td>
            <td class="source-note">{o.method === 'court-or-contract-rate' ? 'Case-specific rule' : (o.method || '').includes('provisional') ? 'Provisional' : (o.method || '').startsWith('statute') ? 'Statute' : (o.method || '').startsWith('derived_') ? 'Formula' : o.confidence === 'high' ? 'Published' : 'Derived'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Source &amp; provenance</h2>
  <p class="source-note">
    Observation recorded {prettyDateTime(latest?.retrieved_at)} from the cited source{sourceRecord?.publisher ? ` (${sourceRecord.publisher})` : ''}:
    <br />
    <a href={latest?.source_url} rel="nofollow noopener" target="_blank">{latest?.source_url}</a>
  </p>

  <CiteThis title={entity.name} url={canonical} note={citeNote} />

  <AdSlot id="rate-bottom" />

  <div class="disclaimer">
    Reference data only — not legal, tax, or financial advice. Always confirm the controlling value
    against the controlling official source and, where applicable, the governing statute or court before relying on it.
  </div>

  <style>
    /* Prejudgment "when it applies" callout — the restrictions are the point, so they lead. */
    .applies { margin: 22px 0 6px; padding: 20px 22px; background: var(--green-wash);
      border: 1px solid var(--line-strong); border-left: 3px solid var(--green); border-radius: 2px; }
    .applies h2 { margin: 0 0 10px; font-size: 1.35rem; }
    .applies-lead { font-size: 1.03rem; color: var(--ink); margin: 0 0 4px; }
    .applies-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 14px 26px; margin: 18px 0 4px; padding-top: 16px; border-top: 1px solid var(--line); }
    .applies-grid h3 { font-family: var(--sans); font-size: 0.68rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.12em; color: var(--gold); margin: 0 0 5px; }
    .applies-grid p { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
    .applies .fineprint { margin: 16px 0 0; padding-top: 12px; border-top: 1px solid var(--line);
      font-size: 0.82rem; color: var(--ink-soft); }
    .xlink { margin: 14px 0; }
    .xlink a { color: var(--green); text-decoration: none; border-bottom: 1px solid var(--line-strong); }
    .xlink a:hover { border-bottom-color: var(--green); }
    .hublink { margin: -6px 0 0; font-size: 0.92rem; }
    .hublink a { color: var(--green); text-decoration: none; border-bottom: 1px solid var(--line-strong); }
    .hublink a:hover { border-bottom-color: var(--green); }
    .kind-chip { display: inline-block; margin-left: 8px; font-family: var(--sans); font-size: 0.66rem;
      font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 3px 10px;
      border-radius: 2px; border: 1px solid var(--line-strong); color: var(--ink-soft); vertical-align: baseline; }
    .rate-facts { margin: 22px 0; padding: 18px 20px; border: 1px solid var(--line-strong);
      background: var(--paper-2); border-radius: 3px; }
    .rate-facts h2 { margin: 0 0 14px; font-size: 1.22rem; }
    .rate-facts dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px 24px; margin: 0; }
    .rate-facts dl div { min-width: 0; }
    .rate-facts dt { margin: 0 0 3px; font-family: var(--sans); font-size: .68rem;
      font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
    .rate-facts dd { margin: 0; font-weight: 650; overflow-wrap: anywhere; }
  </style>
</BaseLayout>
