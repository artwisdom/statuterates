---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CiteThis from '../../components/CiteThis.astro';
import { getMeta, currentOf, latestOf, prettyDate, stateHubs, stateCalculatorReleaseForEntity } from '../../lib/data.mjs';
import { contentModifiedFor, copyFor } from '../../lib/content.mjs';

export function getStaticPaths() {
  return stateHubs().map((h) => ({ params: { state: h.base }, props: { hub: h } }));
}

const { hub } = Astro.props;
const { base, name, pre, post } = hub;
const meta = getMeta();
const allStateHubs = stateHubs();
const hubIndex = allStateHubs.findIndex((candidate) => candidate.base === base);
const previousHub = hubIndex > 0 ? allStateHubs[hubIndex - 1] : null;
const nextHub = hubIndex >= 0 && hubIndex < allStateHubs.length - 1
  ? allStateHubs[hubIndex + 1]
  : null;

const preLatest = currentOf(pre);
const postLatest = post ? currentOf(post) : null;
const postCalculator = post ? stateCalculatorReleaseForEntity(post) : null;
const preCopy = copyFor(pre.slug, {
  observation: preLatest,
  historyPoints: pre.history?.annual_rate?.length,
});
const postCopy = post ? copyFor(post.slug, {
  observation: postLatest,
  historyPoints: post.history?.annual_rate?.length,
}) : null;
const preCaseSpecific = preLatest?.method === 'court-or-contract-rate';
const theName = base === 'dc' ? 'the District of Columbia' : name;
const statuteLabel = (value) => (value || '')
  .replace(/\bSec\.\s*/g, '§ ')
  .replace(/\s+/g, ' ')
  .trim();
const postStatute = post ? statuteLabel(post.metadata?.statute) : null;
const preStatute = statuteLabel(pre.metadata?.statute);
const postEffective = postLatest?.effective_date ? prettyDate(postLatest.effective_date) : null;
const preEffective = prettyDate(preLatest?.effective_date);
const hubYear = [postLatest, preLatest]
  .map((value) => String(value?.retrieved_at || value?.effective_date || '').slice(0, 4))
  .filter(Boolean)
  .sort()
  .at(-1);

// Post-judgment basis line (statute-fixed vs derived/formula) for the at-a-glance row.
const postMethod = postLatest?.method || '';
const postBasis = !post
  ? 'No fixed statutory rate'
  : post.metadata?.basis === 'statute-branching' || postMethod === 'statute-branching'
    ? 'Statutory branches'
    : postMethod.startsWith('statute-fixed')
      ? 'Fixed by statute'
      : postMethod.startsWith('statute')
        ? 'Statutory formula / table'
        : postMethod.startsWith('derived_')
          ? 'Derived formula'
          : 'Published reference';

const standardTitle = `${name} Judgment Interest Rates ${hubYear}`;
const title = base === 'oklahoma'
  ? `Oklahoma Judgment Interest Rates ${hubYear} | 12 O.S. § 727.1`
  : standardTitle;
const description = `${hubYear} ${name} judgment interest: ${post ? `${postLatest?.value_text} post-judgment` : 'case-specific post-judgment'} and ${preCaseSpecific ? 'a contract-rate or court-set prejudgment rule' : `${preLatest?.value_text} prejudgment`}. Statutes, dates, scope, and official sources.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Real modification date = the latest data or hand-recorded substantial editorial change (never
// the build date).
const hubModified = [
  post ? latestOf(post)?.effective_date : null,
  latestOf(pre)?.effective_date,
  post ? contentModifiedFor(post.slug) : null,
  contentModifiedFor(pre.slug),
].filter(Boolean).sort().at(-1);

const faq = [
  post && {
    q: `What is the post-judgment interest rate in ${name}?`,
    a: `As of ${prettyDate(postLatest?.effective_date)}, the ${name} post-judgment interest rate is ${postLatest?.value_text} per year. ${postCopy.tagline}`,
  },
  {
    q: `What is the prejudgment interest rate in ${name}?`,
    a: preCaseSpecific
      ? `${name} has no uniform statewide prejudgment percentage. The governing contract or the judge supplies the rate. ${preCopy.appliesShort || preCopy.tagline}`
      : `${name}'s prejudgment interest rate is ${preLatest?.value_text} per year (${preCopy.kindLabel?.toLowerCase()}). ${preCopy.appliesShort || preCopy.tagline}`,
  },
  {
    q: `Is ${name} judgment interest simple or compound, and when does it start?`,
    a: postCopy?.postDetails
      ? `${postCopy.postDetails.compounding} ${postCopy.postDetails.accrual}`
      : `See each rate's page for the exact compounding rule, accrual date, and statutory carve-outs — ${name} prejudgment interest in particular turns on the type of claim.`,
  },
].filter(Boolean);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${hubYear} ${name} judgment and prejudgment interest rates`,
    url: canonical,
    description,
    isPartOf: { '@type': 'WebSite', name: meta.title, url: new URL('/', Astro.site).href },
    dateModified: hubModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Rates', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'States', item: new URL('/states/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name, item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" style="font-size:.9rem;color:var(--ink-soft);margin-bottom:6px">
    <a href="/">Rates</a> &rsaquo; <a href="/states/">States</a> &rsaquo; <span>{name}</span>
  </nav>
  <div class="eyebrow">Statutory interest rates · {name}</div>
  <h1>{hubYear} {name} judgment &amp; prejudgment interest rates</h1>
  <p class="quick-answer"><strong>Current {hubYear} snapshot:</strong> {post
    ? <>{name} post-judgment interest is <strong>{postLatest?.value_text}</strong> per year</>
    : <>{name} has no uniform statewide post-judgment percentage</>}; {preCaseSpecific
    ? <>prejudgment interest depends on the governing contract or the court</>
    : <>the recorded prejudgment reference is <strong>{preLatest?.value_text}</strong> per year</>}.
  </p>
  <p class="lead">Everything {theName} charges in interest on a money judgment or an overdue debt, in one
    place — the rate <em>after</em> judgment and the rate <em>before</em> it, each
    <a href="/editorial-policy/">recorded with a cited source</a> and linked to its full page with observations,
    scope, and known carve-outs.</p>

  <div class="scroll-x">
    <table class="glance">
      <thead><tr><th scope="col">Metric</th><th scope="col">Rate or rule</th><th scope="col">Effective</th><th scope="col">Authority</th><th scope="col">Basis</th></tr></thead>
      <tbody>
        <tr>
          <td><a href={post ? `/rates/${post.slug}/` : '/methodology/'}>Post-judgment interest</a></td>
          <td class="num">{post ? postLatest?.value_text : '—'}</td>
          <td>{postEffective || 'Case-specific'}</td>
          <td class="source-note">{post
            ? <a href={postLatest?.source_url} rel="noopener" target="_blank">{postStatute || 'Official source'}</a>
            : <a href="/methodology/">See methodology</a>}</td>
          <td class="source-note">{postBasis}</td>
        </tr>
        <tr>
          <td><a href={`/rates/${pre.slug}/`}>Prejudgment interest</a></td>
          <td class="num">{preLatest?.value_text}</td>
          <td>{preEffective}</td>
          <td class="source-note"><a href={preLatest?.source_url} rel="noopener" target="_blank">{preStatute || 'Official source'}</a></td>
          <td class="source-note">{preCopy.kindLabel}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <AdSlot id="state-top" enabled={false} />

  <h2>Post-judgment interest{post ? '' : ' — case by case'}</h2>
  {post ? (
    <>
      <p><strong>{name}'s post-judgment interest rate is {postLatest?.value_text} per year.</strong> {postCopy.body}</p>
      <p class="xlink"><a href={`/rates/${post.slug}/`}>→ Full {name} post-judgment page</a> — {postStatute}, effective-date history, scope, and official source.</p>
      {postCalculator && (
        <p class="xlink"><a href={postCalculator.path}>→ Calculate {name} post-judgment interest</a> — audited statutory scope, annual reset schedule, and printable result.</p>
      )}
    </>
  ) : (
    <p>{name} does not set a single fixed statutory post-judgment rate; interest on a judgment is
      determined case by case rather than by a uniform default. See the
      <a href="/methodology/">methodology</a> for how this is handled, and the prejudgment rate below.</p>
  )}

  <h2>Prejudgment interest</h2>
  <p><strong>{preCaseSpecific
    ? `${name} has no uniform statewide prejudgment percentage (${preCopy.kindLabel?.toLowerCase()}).`
    : `${name}'s prejudgment interest rate is ${preLatest?.value_text} per year (${preCopy.kindLabel?.toLowerCase()}).`}</strong> {preCopy.body}</p>
  <p class="xlink"><a href={`/rates/${pre.slug}/`}>→ Full {name} prejudgment page</a> — {preStatute}, when it applies, accrual, compounding, and carve-outs.</p>
  <AdSlot id="state-bottom" enabled={false} />

  <h2>Frequently asked</h2>
  <div class="faq">
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <CiteThis title={`${name} Judgment & Prejudgment Interest Rates`} url={canonical} note="Each rate includes a cited source and recorded effective date; confirm the controlling authority before use." />

  <p class="source-note" style="margin-top:22px">Compare every state on the
    <a href="/states/">state interest-rate index</a> and the
    <a href="/prejudgment/">prejudgment interest index</a>, or enter a confirmed rate in the
    <a href="/calculators/judgment-interest/">judgment interest and per-diem calculator</a>.
    Reference data only — not legal advice.</p>

  <nav class="state-nav" aria-label="Browse state interest-rate references">
    {previousHub
      ? <a rel="prev" href={`/states/${previousHub.base}/`}>← {previousHub.name}</a>
      : <span aria-hidden="true"></span>}
    <a class="all-states" href="/states/">All states</a>
    {nextHub
      ? <a rel="next" href={`/states/${nextHub.base}/`}>{nextHub.name} →</a>
      : <span aria-hidden="true"></span>}
  </nav>

  <style>
    .glance td.num { font-family: var(--nums); white-space: nowrap; }
    .glance td a { font-weight: 600; color: var(--green); text-decoration: none; border-bottom: 1px solid var(--line); }
    .glance td a:hover { border-bottom-color: var(--green); }
    .quick-answer { margin: 12px 0 20px; padding: 14px 16px; border-left: 3px solid var(--green);
      background: var(--green-wash); color: var(--ink); }
    .xlink { margin: 12px 0; }
    .xlink a { color: var(--green); text-decoration: none; border-bottom: 1px solid var(--line-strong); }
    .xlink a:hover { border-bottom-color: var(--green); }
    .faq details { border-top: 1px solid var(--line); padding: 12px 0; }
    .faq summary { cursor: pointer; font-weight: 600; font-family: var(--serif); font-size: 1.05rem; }
    .faq p { margin: 8px 0 0; color: var(--ink-soft); }
    .state-nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px;
      margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .9rem; }
    .state-nav a { color: var(--green); font-weight: 600; text-decoration: none; }
    .state-nav a:last-child { text-align: right; }
    .state-nav .all-states { color: var(--ink-soft); text-align: center; }
    @media (max-width: 560px) {
      .state-nav { grid-template-columns: 1fr 1fr; }
      .state-nav .all-states { grid-column: 1 / -1; grid-row: 1; }
    }
  </style>
</BaseLayout>
