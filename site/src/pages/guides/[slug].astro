---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CiteThis from '../../components/CiteThis.astro';
import { getMeta, prettyDate } from '../../lib/data.mjs';
import { GUIDES, getGuide } from '../../lib/guides.mjs';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props;
const meta = getMeta();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL('/', Astro.site).href;
const logo = new URL('/logo-512.png', Astro.site).href;
const articleImage = new URL('/og-image.png', Astro.site).href;

// Curated topic clusters keep recommendations genuinely useful instead of depending on array order.
// Each guide is included in at least one other cluster, creating durable contextual discovery paths.
const RELATED_GUIDE_SLUGS = {
  'post-judgment-interest': ['how-to-calculate-judgment-interest', 'prejudgment-interest', 'statutory-interest', 'irs-interest-rates'],
  'prejudgment-interest': ['post-judgment-interest', 'how-to-calculate-judgment-interest', 'statutory-interest', 'late-payment-interest'],
  'how-to-calculate-judgment-interest': ['post-judgment-interest', 'prejudgment-interest', 'statutory-interest', 'irs-interest-rates'],
  'irs-interest-rates': ['irs-penalties-explained', 'statutory-interest', 'how-to-calculate-judgment-interest', 'post-judgment-interest'],
  'irs-penalties-explained': ['irs-interest-rates', 'statutory-interest', 'how-to-calculate-judgment-interest', 'late-payment-interest'],
  'late-payment-interest': ['statutory-interest', 'prejudgment-interest', 'how-to-calculate-judgment-interest', 'post-judgment-interest'],
  'statutory-interest': ['post-judgment-interest', 'prejudgment-interest', 'irs-interest-rates', 'late-payment-interest'],
};
const related = (RELATED_GUIDE_SLUGS[guide.slug] || [])
  .map((slug) => getGuide(slug))
  .filter(Boolean);

// State calculators are intentionally unavailable until their complete rule models pass validation.
// Older guide copy linked to the prototypes, so route those links to the honest reference indexes.
const safeGuideHtml = (html = '') => html
  .replace(/<a href="\/calculators\/state-judgment-interest\/">[^<]*<\/a>/g, '<a href="/states/">state-by-state reference</a>')
  .replace(/<a href="\/calculators\/prejudgment-interest\/">[^<]*<\/a>/g, '<a href="/prejudgment/">prejudgment interest reference</a>')
  .replace(/verified against the official source/gi, 'recorded with a cited source');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.h1,
    description: guide.description,
    url: canonical,
    author: { '@type': 'Organization', name: meta.title, url: origin },
    publisher: {
      '@type': 'Organization',
      name: meta.title,
      url: origin,
      logo: { '@type': 'ImageObject', url: logo, width: 512, height: 512 },
    },
    image: { '@type': 'ImageObject', url: articleImage, width: 1200, height: 630 },
    datePublished: guide.datePublished,
    dateModified: guide.dateModified,
    mainEntityOfPage: canonical,
  },
  guide.faqs?.length && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: guide.h1, item: canonical },
    ],
  },
].filter(Boolean);
---
<BaseLayout title={guide.title} description={guide.description} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" style="font-size:.9rem;color:var(--ink-soft);margin-bottom:6px">
    <a href="/">Home</a> &rsaquo; <a href="/guides/">Guides</a> &rsaquo; <span>{guide.h1}</span>
  </nav>
  <div class="eyebrow">Statutory interest rates · Guide</div>
  <h1>{guide.h1}</h1>
  <div class="lead" set:html={safeGuideHtml(guide.intro_html)} />

  {guide.key_takeaways?.length > 0 && (
    <aside class="takeaways">
      <h2>Key takeaways</h2>
      <ul>{guide.key_takeaways.map((k) => <li>{k}</li>)}</ul>
    </aside>
  )}

  <AdSlot id="guide-top" />

  <article class="guide">
    {guide.sections.map((s) => (
      <>
        <h2>{s.h2}</h2>
        <div set:html={safeGuideHtml(s.body_html)} />
      </>
    ))}
  </article>

  <AdSlot id="guide-bottom" />

  {guide.faqs?.length > 0 && (
    <section class="faq">
      <h2>Frequently asked questions</h2>
      {guide.faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  )}

  <CiteThis
    title={guide.h1}
    url={canonical}
    note={`Last updated ${prettyDate(guide.dateModified)}; confirm the controlling authority before use.`}
  />

  {related.length > 0 && (
    <section class="related">
      <h2>More guides</h2>
      <ul class="clean">
        {related.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.h1}</a></li>)}
      </ul>
    </section>
  )}

  <div class="disclaimer">Reference and educational content — not legal, tax, or financial advice.
    Always confirm the controlling rate against the official statute or your court before relying on it.</div>

  <style>
    .takeaways { background: var(--green-wash); border: 1px solid var(--line-strong); border-left: 3px solid var(--green); border-radius: 2px; padding: 14px 20px; margin: 20px 0; }
    .takeaways h2 { font-size: 0.72rem; font-family: var(--sans); text-transform: uppercase; letter-spacing: 0.12em; color: var(--gold-ink); margin: 0 0 8px; }
    .takeaways ul { margin: 0; padding-left: 20px; }
    .takeaways li { margin: 5px 0; }
    .guide :global(h2) { margin-top: 30px; }
    .guide :global(p) { max-width: var(--measure); }
    .guide :global(a) { color: var(--green); }
    .faq details { border-top: 1px solid var(--line); padding: 12px 0; }
    .faq summary { cursor: pointer; font-weight: 600; font-family: var(--serif); font-size: 1.05rem; }
    .faq p { margin: 8px 0 0; color: var(--ink-soft); }
    .related ul { columns: 2; }
    @media (max-width: 520px) { .related ul { columns: 1; } }
  </style>
</BaseLayout>
